{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "kagent.api.v1.AuthorizationResource.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(mcpTool)$": {
          "$ref": "#/$defs/kagent.api.v1.MCPToolAuthorizationReference.schema.json"
        },
        "^(sessionId)$": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "properties": {
        "kubernetes": {
          "$ref": "#/$defs/kagent.api.v1.KubernetesAuthorizationReference.schema.json"
        },
        "mcp_tool": {
          "$ref": "#/$defs/kagent.api.v1.MCPToolAuthorizationReference.schema.json"
        },
        "session_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/kagent.api.v1.TaskReference.schema.json"
        },
        "workspace": {
          "$ref": "#/$defs/kagent.api.v1.WorkspaceAuthorizationReference.schema.json"
        }
      },
      "title": "Authorization Resource",
      "type": "object"
    },
    "kagent.api.v1.CreateSessionResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "session": {
          "$ref": "#/$defs/kagent.api.v1.Session.schema.json"
        }
      },
      "title": "Create Session Response",
      "type": "object"
    },
    "kagent.api.v1.Failure.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "message": {
          "default": "",
          "type": "string"
        },
        "reason": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Failure",
      "type": "object"
    },
    "kagent.api.v1.KubernetesAuthorizationReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "AUTHORIZATION_SCOPE_KIND_AGENT",
                "AUTHORIZATION_SCOPE_KIND_AGENT_TEMPLATE",
                "AUTHORIZATION_SCOPE_KIND_HARNESS",
                "AUTHORIZATION_SCOPE_KIND_MODEL_CONNECTION",
                "AUTHORIZATION_SCOPE_KIND_MCP_SERVER"
              ],
              "type": "string"
            },
            {
              "maximum": 3,
              "minimum": 2,
              "type": "integer"
            },
            {
              "maximum": 8,
              "minimum": 6,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Authorization Scope Kind"
        },
        "ref": {
          "$ref": "#/$defs/kagent.api.v1.ResourceReference.schema.json"
        },
        "uid": {
          "default": "",
          "description": "When supplied, this must match the object's current UID.",
          "maxLength": 128,
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Kubernetes Authorization Reference",
      "type": "object"
    },
    "kagent.api.v1.MCPToolAuthorizationReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "server": {
          "$ref": "#/$defs/kagent.api.v1.KubernetesAuthorizationReference.schema.json"
        }
      },
      "required": [
        "server"
      ],
      "title": "MCP Tool Authorization Reference",
      "type": "object"
    },
    "kagent.api.v1.ResourceGrant.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "PERMISSION_AGENT_READ",
                  "PERMISSION_AGENT_CREATE",
                  "PERMISSION_AGENT_UPDATE",
                  "PERMISSION_AGENT_DELETE",
                  "PERMISSION_AGENT_INVOKE",
                  "PERMISSION_TEMPLATE_READ",
                  "PERMISSION_TEMPLATE_CREATE",
                  "PERMISSION_TEMPLATE_UPDATE",
                  "PERMISSION_TEMPLATE_DELETE",
                  "PERMISSION_TEMPLATE_USE",
                  "PERMISSION_WORKFLOW_READ",
                  "PERMISSION_WORKFLOW_EDIT",
                  "PERMISSION_WORKFLOW_PUBLISH",
                  "PERMISSION_WORKFLOW_EXECUTE",
                  "PERMISSION_SESSION_READ",
                  "PERMISSION_SESSION_CREATE",
                  "PERMISSION_SESSION_SEND",
                  "PERMISSION_SESSION_SHARE",
                  "PERMISSION_SESSION_DELETE",
                  "PERMISSION_TASK_READ",
                  "PERMISSION_TASK_CANCEL",
                  "PERMISSION_TASK_RESPOND",
                  "PERMISSION_ACCESS_READ",
                  "PERMISSION_ACCESS_MANAGE",
                  "PERMISSION_HARNESS_READ",
                  "PERMISSION_HARNESS_USE",
                  "PERMISSION_HARNESS_MANAGE",
                  "PERMISSION_MODEL_CONNECTION_READ",
                  "PERMISSION_MODEL_CONNECTION_USE",
                  "PERMISSION_MODEL_CONNECTION_MANAGE",
                  "PERMISSION_MCP_SERVER_READ",
                  "PERMISSION_MCP_SERVER_USE",
                  "PERMISSION_MCP_SERVER_MANAGE",
                  "PERMISSION_MCP_TOOL_CALL"
                ],
                "type": "string"
              },
              {
                "maximum": 34,
                "minimum": 1,
                "type": "integer"
              }
            ],
            "title": "Permission"
          },
          "maxItems": 34,
          "minItems": 1,
          "type": "array"
        },
        "resource": {
          "$ref": "#/$defs/kagent.api.v1.AuthorizationResource.schema.json"
        }
      },
      "required": [
        "resource"
      ],
      "title": "Resource Grant",
      "type": "object"
    },
    "kagent.api.v1.ResourceGrantSet.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResourceGrantSet records exact resource identities and actions.",
      "properties": {
        "grants": {
          "items": {
            "$ref": "#/$defs/kagent.api.v1.ResourceGrant.schema.json"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "title": "Resource Grant Set",
      "type": "object"
    },
    "kagent.api.v1.ResourceReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "",
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?([.][a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "type": "string"
        },
        "namespace": {
          "default": "",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "title": "Resource Reference",
      "type": "object"
    },
    "kagent.api.v1.ScopeCeiling.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ScopeCeiling is an immutable upper bound. Absent means inherit; present and\n empty means no scopes. Every use also applies the initiator's current scopes.",
      "properties": {
        "resources": {
          "$ref": "#/$defs/kagent.api.v1.ResourceGrantSet.schema.json",
          "description": "Absent in a request inherits resolved dependencies; an empty set denies all.\n Persisted execution authority always records a UID-bound set."
        },
        "scopes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "title": "Scope Ceiling",
      "type": "object"
    },
    "kagent.api.v1.Session.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(a2aAuthority)$": {
          "default": "",
          "type": "string"
        },
        "^(contextId)$": {
          "default": "",
          "description": "Output only. A2A conversation ID, equal to this session's ID.\n Forks receive a new conversation ID and new task IDs.",
          "type": "string"
        },
        "^(createdAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(preparedRevision)$": {
          "default": "",
          "type": "string"
        },
        "^(updatedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "properties": {
        "a2a_authority": {
          "default": "",
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/kagent.api.v1.ResourceReference.schema.json"
        },
        "authority": {
          "$ref": "#/$defs/kagent.api.v1.SessionAuthority.schema.json",
          "description": "Output only. Immutable execution authority captured at creation."
        },
        "context_id": {
          "default": "",
          "description": "Output only. A2A conversation ID, equal to this session's ID.\n Forks receive a new conversation ID and new task IDs.",
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "creator": {
          "default": "",
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/kagent.api.v1.Failure.schema.json"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "description": "Reader-supplied display name for the conversation. Empty means unnamed,\n which is the state every session created before this field existed is in.",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "pattern": "^RUNTIME_OPERATION_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "RUNTIME_OPERATION_CREATE",
                "RUNTIME_OPERATION_SUSPEND",
                "RUNTIME_OPERATION_RESUME",
                "RUNTIME_OPERATION_DELETE",
                "RUNTIME_OPERATION_NONE"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Runtime Operation"
        },
        "prepared_revision": {
          "default": "",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^RUNTIME_STATE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "RUNTIME_STATE_CREATING",
                "RUNTIME_STATE_READY",
                "RUNTIME_STATE_SUSPENDED",
                "RUNTIME_STATE_FAILED",
                "RUNTIME_STATE_DELETING",
                "RUNTIME_STATE_DELETED"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Runtime State"
        },
        "updated_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Session",
      "type": "object"
    },
    "kagent.api.v1.SessionAuthority.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SessionAuthority separates the initiator from the Actor and storage owner.\n Parent and root identities are derived by the controller, never caller input.",
      "patternProperties": {
        "^(expiresAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(initiatorId)$": {
          "default": "",
          "type": "string"
        },
        "^(parentSessionId)$": {
          "default": "",
          "type": "string"
        },
        "^(rootSessionId)$": {
          "default": "",
          "type": "string"
        },
        "^(scopeCeiling)$": {
          "$ref": "#/$defs/kagent.api.v1.ScopeCeiling.schema.json"
        },
        "^(sessionId)$": {
          "default": "",
          "type": "string"
        },
        "^(workspaceUid)$": {
          "default": "",
          "description": "Immutable Kubernetes namespace UID captured by the native Session service.",
          "type": "string"
        }
      },
      "properties": {
        "expires_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "initiator_id": {
          "default": "",
          "type": "string"
        },
        "parent_session_id": {
          "default": "",
          "type": "string"
        },
        "root_session_id": {
          "default": "",
          "type": "string"
        },
        "scope_ceiling": {
          "$ref": "#/$defs/kagent.api.v1.ScopeCeiling.schema.json"
        },
        "session_id": {
          "default": "",
          "type": "string"
        },
        "workspace_uid": {
          "default": "",
          "description": "Immutable Kubernetes namespace UID captured by the native Session service.",
          "type": "string"
        }
      },
      "title": "Session Authority",
      "type": "object"
    },
    "kagent.api.v1.TaskReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(sessionId)$": {
          "default": "",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "^(taskId)$": {
          "default": "",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "properties": {
        "session_id": {
          "default": "",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "task_id": {
          "default": "",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Task Reference",
      "type": "object"
    },
    "kagent.api.v1.WorkspaceAuthorizationReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "default": "",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        },
        "uid": {
          "default": "",
          "description": "When supplied, this must match the namespace's current UID.",
          "maxLength": 128,
          "type": "string"
        }
      },
      "title": "Workspace Authorization Reference",
      "type": "object"
    }
  },
  "$id": "kagent.api.v1.CreateSessionResponse.schema.bundle.json",
  "$ref": "#/$defs/kagent.api.v1.CreateSessionResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
