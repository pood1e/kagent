{
  "$defs": {
    "kagent.runtime.v1.MemoryScope.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(agentName)$": {
          "minLength": 1,
          "type": "string"
        },
        "^(teamNamespace)$": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "properties": {
        "agent_name": {
          "minLength": 1,
          "type": "string"
        },
        "team_namespace": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "title": "Memory Scope",
      "type": "object"
    }
  },
  "$id": "kagent.runtime.v1.MemoryScope.schema.bundle.json",
  "$ref": "#/$defs/kagent.runtime.v1.MemoryScope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
